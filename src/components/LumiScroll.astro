---
interface Props {
	logo?: string;
	logoAlt?: string;
	tagline?: string;
	cta?: { text: string; href: string };
	warning?: string;
	canvasLabel: string;
}

const { logo, logoAlt, tagline, cta, warning, canvasLabel } = Astro.props;
---

<div class="lumi-scroll" data-model="/assets/3d/lumi/" data-spin-share="0.3" data-shadow="#000000" data-frame="290" data-frame-wide="340">
	<div class="lumi-scroll__stage">
		<div class="container lumi-scroll__content">
			{logo && <img src={logo} alt={logoAlt} class="lumi-scroll__logo" width="1024" height="1024" loading="eager" />}
			{tagline && <h2 class="lumi-scroll__tagline">{tagline}</h2>}
			{cta && (
				<a
					href={cta.href}
					class="lumi-scroll__cta"
					{...cta.href.startsWith('http') && { target: '_blank', rel: 'noopener noreferrer' }}
				>
					{cta.text}
				</a>
			)}
			{warning && <p class="lumi-scroll__warning">{warning}</p>}
		</div>
		<canvas role="img" aria-label={canvasLabel}></canvas>
		<div class="lumi-scroll__indicator" aria-hidden="true">
			<svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
				<path d="M7 14L12 19L17 14" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
				<path d="M7 5L12 10L17 5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
			</svg>
		</div>
	</div>
</div>

<style>
	.lumi-scroll {
		--lumi-length: 450vh; /* scroll distance: longer = slower animation */
		position: relative;
		height: var(--lumi-length);
		background: var(--gray-900);
	}

	/* the canvas fills the whole stage; the intro text sits on top of it and fades out on scroll */
	.lumi-scroll__stage {
		position: sticky;
		top: 0;
		height: 100vh;
		height: 100svh;
		overflow: hidden;
	}

	.container {
		max-width: 1200px;
		margin: 0 auto;
		padding: 0 2rem;
		width: 100%;
	}

	.lumi-scroll__content {
		position: absolute;
		inset: 0 0 auto;
		z-index: 1;
		padding-top: 1.5rem;
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 1rem;
		text-align: center;
		/* --lumi-progress (0 to 1) is set by the script: fully gone after ~8% of the scroll */
		opacity: clamp(0, calc(1 - var(--lumi-progress, 0) * 12), 1);
		transform: translateY(calc(var(--lumi-progress, 0) * -600px));
	}

	.lumi-scroll:global(.is-scrolled) .lumi-scroll__content {
		visibility: hidden;
	}

	.lumi-scroll__logo {
		/* the logo file has empty space around it, hence the negative margin */
		height: clamp(140px, 28vh, 320px);
		width: auto;
		margin-block: -3rem -5rem;
		position: relative;
		z-index: 1;
	}

	.lumi-scroll__tagline {
		position: relative;
		z-index: 1;
		font-size: clamp(1.5rem, 3vw, 2.5rem);
		font-weight: 600;
		margin: 0;
		padding-top: 2rem;
		color: var(--gray-100);
		line-height: 1.3;
		text-wrap: balance;
	}

	.lumi-scroll__cta {
		position: relative;
		z-index: 1;
		background: var(--accent-regular);
		color: var(--accent-text-over);
		padding: 0.6rem 1.75rem;
		border-radius: 999px;
		text-decoration: none;
		font-weight: 600;
		font-size: 1rem;
		transition: all 0.3s ease;
		border: 1px solid var(--accent-light);
		box-shadow: 0 0 24px var(--accent-overlay);
	}

	.lumi-scroll__cta:hover {
		background: var(--accent-dark);
		transform: translateY(-2px);
		box-shadow: 0 0 32px var(--accent-overlay);
	}

	.lumi-scroll__warning {
		position: relative;
		z-index: 1;
		max-width: 36rem;
		margin: 0;
		padding: 0.4rem 1rem;
		border: 1px solid #f87171;
		border-radius: 0.75rem;
		background: rgba(248, 113, 113, 0.1);
		color: #f87171;
		font-size: 0.8rem;
		font-weight: 600;
		line-height: 1.4;
		text-wrap: balance;
	}

	.lumi-scroll canvas {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		display: block;
		opacity: 0;
		transition: opacity 0.4s ease;
	}

	.lumi-scroll:global(.is-ready) canvas {
		opacity: 1;
	}

	/* same bubble as the homepage ScrollIndicator; hidden once the 360° turn is over */
	.lumi-scroll__indicator {
		position: absolute;
		bottom: 2rem;
		left: 50%;
		z-index: 1;
		width: 3.5rem;
		height: 3.5rem;
		border-radius: 50%;
		display: flex;
		align-items: center;
		justify-content: center;
		background: var(--accent-regular);
		color: var(--accent-text-over);
		border: 2px solid rgba(255, 255, 255, 0.2);
		box-shadow: var(--shadow-lg);
		animation: lumi-bounce 2s infinite;
		transition: opacity 0.3s ease;
	}

	.lumi-scroll__indicator svg {
		opacity: 0.9;
	}

	.lumi-scroll:global(.is-done) .lumi-scroll__indicator {
		opacity: 0;
	}

	@keyframes lumi-bounce {
		0%, 20%, 50%, 80%, 100% {
			transform: translateX(-50%) translateY(0);
		}
		40% {
			transform: translateX(-50%) translateY(-8px);
		}
		60% {
			transform: translateX(-50%) translateY(-4px);
		}
	}

	@media (max-width: 50em) {
		.lumi-scroll__indicator {
			bottom: 1.5rem;
			width: 3rem;
			height: 3rem;
		}

		.lumi-scroll__indicator svg {
			width: 20px;
			height: 20px;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.lumi-scroll {
			height: auto;
		}

		.lumi-scroll__stage {
			position: relative;
		}

		/* no scroll animation: keep the intro text visible over the assembled Lumi */
		.lumi-scroll__content {
			opacity: 1;
			transform: none;
		}

		.lumi-scroll:global(.is-scrolled) .lumi-scroll__content {
			visibility: visible;
		}

		.lumi-scroll canvas {
			transition: none;
		}

		.lumi-scroll__indicator {
			display: none;
		}
	}
</style>

<script>
	// three.js and the model (~1.6 MB) load as soon as the section is near, or once the page has finished loading
	const pending = new Set(document.querySelectorAll('.lumi-scroll'));

	function loadNearSections() {
		for (const section of pending) {
			if (section.getBoundingClientRect().top > innerHeight * 2) continue;
			pending.delete(section);
			import('../scripts/lumi-scroll-3d.js')
				.then(({ initLumiScroll }) => initLumiScroll(section))
				.catch((e) => console.error('[lumi-scroll]', e));
		}
		if (!pending.size) removeEventListener('scroll', loadNearSections);
	}

	addEventListener('scroll', loadNearSections, { passive: true });
	loadNearSections();

	// the section sits right below the product hero, so load it anyway once the rest of the page is done
	function loadAll() {
		for (const section of pending) {
			import('../scripts/lumi-scroll-3d.js')
				.then(({ initLumiScroll }) => initLumiScroll(section))
				.catch((e) => console.error('[lumi-scroll]', e));
		}
		pending.clear();
		removeEventListener('scroll', loadNearSections);
	}
	if (document.readyState === 'complete') loadAll();
	else addEventListener('load', loadAll, { once: true });
</script>
