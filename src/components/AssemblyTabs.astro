---
// Notice de montage en deux onglets : la liste classique (AssemblyGuide)
// ou une version animée qui présente une étape à la fois.
import AssemblyGuide from './AssemblyGuide.astro';
import AnimVideo from './AnimVideo.astro';
import StepPlayer from './StepPlayer.astro';
import type { Locale } from '../i18n';

interface Image {
  src: string;
  alt: string;
}

interface Step {
  number: number;
  title: string;
  description: string;
  image?: string;
  alt?: string;
  images?: Image[];
  // Animation affichée dans l'onglet animé à la place des images :
  // chemin sans extension, décliné en .webm (VP9 alpha) et .mov (HEVC alpha, Safari)
  animation?: string;
}

interface Props {
  title: string;
  subtitle?: string;
  steps: Step[];
  nextLink?: { href: string; label: string };
  locale?: Locale;
}

const ui = {
  fr: { switcher: 'Affichage de la notice', animated: 'Notice animée', classic: 'Notice classique', step: 'Étape', of: 'sur' },
  en: { switcher: 'Guide display', animated: 'Animated guide', classic: 'Classic guide', step: 'Step', of: 'of' }
};

const {
  title,
  subtitle = 'Instructions détaillées pour assembler votre lunette Lumi',
  steps,
  nextLink,
  locale = 'fr'
} = Astro.props;
const t = ui[locale];

const media = (step: Step): Image[] =>
  step.images ?? (step.image ? [{ src: step.image, alt: step.alt ?? '' }] : []);
---

<div class="assembly-tabs" data-mode="animated" data-assembly-tabs>
  <div class="mode-switch" role="group" aria-label={t.switcher}>
    <button type="button" data-mode-btn="animated" aria-pressed="true">{t.animated}</button>
    <button type="button" data-mode-btn="list" aria-pressed="false">{t.classic}</button>
  </div>

  <div class="animated wrapper">
    <header class="section-header stack gap-2">
      <h2>{title}</h2>
      <p>{subtitle}</p>
    </header>

    <StepPlayer labels={steps.map((step) => String(step.number))} nextLink={nextLink} locale={locale}>
      {steps.map((step, i) => {
        const imgs = media(step);
        return (
          <article class="slide" data-slide hidden={i !== 0}>
            {step.animation ? (
              <div class="media animation">
                <AnimVideo src={step.animation} label={step.alt} locale={locale} />
              </div>
            ) : (
            <div class:list={['media', { multi: imgs.length > 1 }]}>
              {imgs.map((img) => (
                <img
                  src={img.src}
                  alt={img.alt}
                  loading={i === 0 ? 'eager' : 'lazy'}
                  class="lightbox-trigger"
                  data-src={img.src}
                  data-alt={img.alt}
                />
              ))}
            </div>
            )}
            <div class="text">
              <p class="kicker">{t.step} {step.number} <span>{t.of} {steps.length}</span></p>
              {step.title && <h3>{step.title}</h3>}
              <p class="desc" set:html={step.description}></p>
            </div>
          </article>
        );
      })}
    </StepPlayer>
  </div>

  <div class="classic">
    <AssemblyGuide title={title} subtitle={subtitle} steps={steps} locale={locale} />
  </div>
</div>

<style>
  /* On masque la liste mais pas sa Lightbox, utilisée aussi par l'onglet animé. */
  .assembly-tabs[data-mode='list'] .animated { display: none; }
  .assembly-tabs[data-mode='animated'] .classic :global(.assembly-guide) { display: none; }

  /* !important : la page Lumi force des couleurs globales sur les liens et boutons */
  .mode-switch {
    display: flex;
    gap: 4px;
    width: max-content;
    margin: 3rem auto 0;
    padding: 4px;
    border-radius: 999px;
    background: var(--gray-900);
    border: 1px solid var(--gray-700);
    position: relative;
    z-index: 1;
  }
  .mode-switch button {
    all: unset;
    cursor: pointer;
    padding: 0.5rem 1.1rem;
    border-radius: 999px !important;
    font-size: var(--text-sm);
    font-weight: 600;
    background: transparent !important;
    border: none !important;
    color: var(--gray-300) !important;
  }
  .mode-switch button[aria-pressed='true'] {
    background: var(--gray-0) !important;
    color: var(--gray-999) !important;
  }
  .mode-switch button:focus-visible { outline: 2px solid var(--accent-regular); }

  .animated { padding-block: 3rem 5rem; }
  .section-header {
    text-align: center;
    max-width: 50ch;
    margin: 0 auto 2rem;
    color: var(--gray-300);
  }
  .section-header h2 { font-size: var(--text-2xl); color: var(--gray-0); }
  @media (min-width: 50em) {
    .section-header h2 { font-size: var(--text-4xl); }
  }

  .media {
    background: #fff;
    border-radius: 1rem;
    aspect-ratio: 1 / 1;
    display: grid;
    padding: 0.75rem;
    gap: 0.75rem;
    overflow: hidden;
  }
  .media.multi { grid-auto-rows: minmax(0, 1fr); }
  /* Les animations ont un fond transparent ; les schémas fixes gardent le fond blanc (légendes en noir) */
  .media.animation { background: transparent; padding: 0; }
  .media img {
    width: 100%;
    height: 100%;
    min-height: 0;
    object-fit: contain;
    cursor: zoom-in;
  }

  .text { color: var(--gray-200); line-height: 1.6; }
  .kicker {
    font-size: var(--text-sm);
    text-transform: uppercase;
    letter-spacing: 0.12em;
    font-weight: 700;
    color: var(--gray-0);
    margin-bottom: 0.75rem;
  }
  .kicker span { color: var(--gray-300); font-weight: 500; }
  .text h3 { font-size: var(--text-xl); color: var(--gray-0); margin-bottom: 0.75rem; }
  .desc { font-size: var(--text-lg); }

  @media (max-width: 760px) {
    .desc { font-size: var(--text-base); }
  }
</style>

<script>
  const root = document.querySelector<HTMLElement>('[data-assembly-tabs]');

  if (root) {
    // Choix de l'onglet, mémorisé pour le visiteur
    const buttons = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-mode-btn]'));
    const setMode = (mode: string) => {
      root.dataset.mode = mode;
      buttons.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.modeBtn === mode)));
    };
    buttons.forEach((b) => b.addEventListener('click', () => {
      setMode(b.dataset.modeBtn!);
      try { localStorage.setItem('lumi-notice-choice', b.dataset.modeBtn!); } catch {}
    }));

    let saved: string | null = null;
    try { saved = localStorage.getItem('lumi-notice-choice'); } catch {}
    setMode(saved === 'list' ? 'list' : 'animated');
  }
</script>
