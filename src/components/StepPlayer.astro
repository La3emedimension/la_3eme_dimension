---
// Lecteur à volets : un contenu à la fois, avec barre de progression, onglets,
// boutons Précédent / Suivant, flèches du clavier et balayage sur mobile.
// Chaque volet est un élément enfant portant la classe "slide" et l'attribut data-slide
// (tous sauf le premier avec l'attribut hidden).
import type { Locale } from '../i18n';

interface Props {
  labels: string[];
  locale?: Locale;
  // 'number' : pastilles numérotées ; 'text' : onglets avec le libellé
  rail?: 'number' | 'text';
  railLabel?: string;
  nextLink?: { href: string; label: string };
}

const ui = {
  fr: { steps: 'Étapes', prev: 'Précédent', next: 'Suivant' },
  en: { steps: 'Steps', prev: 'Previous', next: 'Next' }
};

const { labels, locale = 'fr', rail = 'number', nextLink } = Astro.props;
const t = ui[locale];
const railLabel = Astro.props.railLabel ?? t.steps;
---

<div class="player" data-step-player tabindex="-1">
  <div class="progress" aria-hidden="true"><span data-progress></span></div>

  <ol class:list={['rail', rail]} aria-label={railLabel}>
    {labels.map((label, i) => (
      <li>
        <button type="button" data-goto={i} aria-label={rail === 'number' ? `${railLabel} ${label}` : undefined} aria-current={i === 0 ? 'step' : undefined}>
          {rail === 'text' && <span class="num">{i + 1}</span>}
          {label}
        </button>
      </li>
    ))}
  </ol>

  <slot />

  <div class="controls">
    <button type="button" class="ctrl" data-prev>← {t.prev}</button>
    <span class="counter" data-counter aria-live="polite">1 / {labels.length}</span>
    <button type="button" class="ctrl primary" data-next>{t.next} →</button>
    {nextLink && <a class="ctrl primary" href={nextLink.href} data-finish hidden>{nextLink.label} →</a>}
  </div>
</div>

<style>
  .player {
    /* min-width: 0 : dans un conteneur flex, la rangée d'onglets défile au lieu d'élargir le lecteur */
    width: 100%;
    min-width: 0;
    max-width: 64rem;
    margin: 0 auto;
    /* plus clair que les cartes du site */
    background: color-mix(in srgb, var(--gray-700), var(--gray-600));
    border: 1px solid var(--gray-500);
    border-radius: 1.5rem;
    overflow: hidden;
    outline: none;
  }

  .progress { height: 4px; background: var(--gray-500); }
  .progress span {
    display: block;
    height: 100%;
    width: 0;
    background: var(--gray-0);
    transition: width 0.35s ease;
  }

  /* !important : la page Lumi force des couleurs globales sur les liens et boutons */
  .rail {
    list-style: none;
    margin: 0;
    padding: 1rem 1.5rem 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    justify-content: center;
  }
  .rail button {
    all: unset;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    font-size: var(--text-sm);
    font-weight: 700;
    font-variant-numeric: tabular-nums;
    background: transparent !important;
    border: 1px solid var(--gray-500) !important;
    color: var(--gray-300) !important;
    transition: background 0.2s, color 0.2s;
  }
  .rail.number button { width: 2.25rem; height: 2.25rem; border-radius: 50% !important; }
  .rail.text button { padding: 0.45rem 0.9rem 0.45rem 0.45rem; border-radius: 999px !important; white-space: nowrap; }
  .rail.text .num {
    width: 1.5rem;
    height: 1.5rem;
    display: grid;
    place-items: center;
    border-radius: 50%;
    background: var(--gray-500);
    color: var(--gray-0);
    font-size: var(--text-xs, 0.75rem);
  }
  .rail button.done { border-color: var(--gray-300) !important; color: var(--gray-0) !important; }
  .rail button[aria-current='step'] {
    background: var(--gray-0) !important;
    border-color: var(--gray-0) !important;
    color: var(--gray-999) !important;
  }
  .rail button[aria-current='step'] .num { background: var(--gray-999); color: var(--gray-0); }
  .rail button:focus-visible { outline: 2px solid var(--accent-regular); outline-offset: 2px; }

  /* Les sections règlent leurs colonnes via --slide-cols sur leurs volets */
  .player :global(.slide) {
    display: grid;
    grid-template-columns: var(--slide-cols, minmax(0, 1.25fr) minmax(0, 1fr));
    gap: 2rem;
    padding: 1.5rem;
    align-items: start;
    animation: slide-in 0.35s ease both;
  }
  .player :global(.slide[hidden]) { display: none; }
  .player :global(.slide.from-left) { animation-name: slide-in-left; }
  @keyframes slide-in { from { opacity: 0; transform: translateX(24px); } }
  @keyframes slide-in-left { from { opacity: 0; transform: translateX(-24px); } }
  @media (prefers-reduced-motion: reduce) { .player :global(.slide) { animation: none; } }

  .controls {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 1rem 1.5rem 1.5rem;
  }
  .ctrl {
    all: unset;
    cursor: pointer;
    padding: 0.65rem 1.25rem;
    border-radius: 999px !important;
    font-weight: 600;
    font-size: var(--text-sm);
    background: transparent !important;
    border: 1px solid var(--gray-500) !important;
    color: var(--gray-0) !important;
  }
  .ctrl.primary {
    background: var(--gray-0) !important;
    border-color: var(--gray-0) !important;
    color: var(--gray-999) !important;
  }
  .ctrl[disabled] { opacity: 0.35; cursor: default; }
  .ctrl[hidden] { display: none; }
  .ctrl:focus-visible { outline: 2px solid var(--accent-regular); outline-offset: 2px; }
  .counter { color: var(--gray-300); font-size: var(--text-sm); font-variant-numeric: tabular-nums; }

  @media (max-width: 760px) {
    .player :global(.slide) { grid-template-columns: 1fr; gap: 1.25rem; padding: 1rem; }
    .rail { gap: 0.35rem; padding-inline: 1rem; }
    .rail.number button { width: 2rem; height: 2rem; }
    /* Les onglets texte défilent horizontalement plutôt que de s'empiler */
    .rail.text { flex-wrap: nowrap; justify-content: flex-start; overflow-x: auto; scrollbar-width: none; padding-bottom: 2px; }
    .rail.text::-webkit-scrollbar { display: none; }
    .controls { padding: 0.75rem 1rem 1rem; }
    .ctrl { padding: 0.6rem 1rem; }
  }
</style>

<script>
  import { play, reduceMotion } from '../lib/animVideo';

  const players = Array.from(document.querySelectorAll<HTMLElement>('[data-step-player]'));
  const controllers = new Map<HTMLElement, (d: number) => void>();

  for (const player of players) {
    const slides = Array.from(player.querySelectorAll<HTMLElement>('[data-slide]'));
    const dots = Array.from(player.querySelectorAll<HTMLButtonElement>('[data-goto]'));
    const prev = player.querySelector<HTMLButtonElement>('[data-prev]')!;
    const next = player.querySelector<HTMLButtonElement>('[data-next]')!;
    const finish = player.querySelector<HTMLElement>('[data-finish]');
    const counter = player.querySelector<HTMLElement>('[data-counter]')!;
    const bar = player.querySelector<HTMLElement>('[data-progress]')!;
    let current = 0;
    // Vidéos au moins à moitié visibles à l'écran
    const visible = new Set<HTMLVideoElement>();

    const video = (i: number) => slides[i]?.querySelector<HTMLVideoElement>('[data-anim]');
    const playCurrent = () => {
      const v = video(current);
      if (v && visible.has(v) && !reduceMotion() && !v.dataset.userPaused) play(v);
    };

    const show = (i: number) => {
      i = Math.min(Math.max(i, 0), slides.length - 1);
      const back = i < current;
      slides.forEach((s, k) => {
        s.hidden = k !== i;
        s.classList.toggle('from-left', back);
      });
      // Chaque volet repart du début ; les autres animations sont arrêtées
      slides.forEach((_, k) => {
        const v = video(k);
        if (!v) return;
        v.pause();
        if (k === i) {
          v.currentTime = 0;
          delete v.dataset.userPaused;
        }
      });
      dots.forEach((d, k) => {
        if (k === i) d.setAttribute('aria-current', 'step');
        else d.removeAttribute('aria-current');
        d.classList.toggle('done', k < i);
      });
      // Onglets défilants (mobile) : centrer l'onglet actif sans faire défiler la page
      const rail = dots[i]?.closest<HTMLElement>('.rail');
      if (rail && rail.scrollWidth > rail.clientWidth) {
        const r = rail.getBoundingClientRect();
        const d = dots[i].getBoundingClientRect();
        rail.scrollTo({ left: rail.scrollLeft + d.left - r.left - (r.width - d.width) / 2, behavior: 'smooth' });
      }
      const last = i === slides.length - 1;
      prev.disabled = i === 0;
      next.hidden = last && !!finish;
      next.disabled = last;
      if (finish) finish.hidden = !last;
      counter.textContent = `${i + 1} / ${slides.length}`;
      bar.style.width = `${((i + 1) / slides.length) * 100}%`;
      current = i;
      playCurrent();
    };

    prev.addEventListener('click', () => show(current - 1));
    next.addEventListener('click', () => show(current + 1));
    dots.forEach((d) => d.addEventListener('click', () => show(Number(d.dataset.goto))));

    // Balayage sur mobile
    let startX = 0;
    player.addEventListener('touchstart', (e) => (startX = e.touches[0].clientX), { passive: true });
    player.addEventListener('touchend', (e) => {
      const dx = e.changedTouches[0].clientX - startX;
      if (Math.abs(dx) > 50) show(current + (dx < 0 ? 1 : -1));
    });

    // Les animations ne tournent que lorsqu'elles sont à l'écran : on observe l'animation
    // elle-même, car sur mobile le texte sous l'animation rend le lecteur très haut
    const observer = new IntersectionObserver((entries) => {
      for (const entry of entries) {
        const v = entry.target as HTMLVideoElement;
        if (entry.isIntersecting) visible.add(v);
        else {
          visible.delete(v);
          v.pause();
        }
      }
      playCurrent();
    }, { threshold: 0.5 });
    slides.forEach((_, k) => {
      const v = video(k);
      if (v) observer.observe(v);
    });

    controllers.set(player, (d) => show(current + d));
    show(0);
  }

  // Flèches du clavier : pilotent le lecteur affiché au milieu de l'écran
  addEventListener('keydown', (e) => {
    if (e.key !== 'ArrowRight' && e.key !== 'ArrowLeft') return;
    if (document.querySelector('.lightbox.active')) return;
    if ((e.target as HTMLElement).closest?.('input, textarea, select, [contenteditable]')) return;
    const mid = innerHeight / 2;
    const player = players.find((p) => {
      if (p.offsetParent === null) return false;
      const r = p.getBoundingClientRect();
      return r.top <= mid && r.bottom >= mid;
    });
    if (player) controllers.get(player)!(e.key === 'ArrowRight' ? 1 : -1);
  });
</script>
