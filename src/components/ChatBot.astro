---
interface Props {
  locale?: 'fr' | 'en';
}

const { locale = 'fr' } = Astro.props;

// Remplace par l'URL de ton Worker une fois déployé (ex: https://la3emedim-chatbot.<ton-sous-domaine>.workers.dev)
const CHAT_API_URL = 'https://la3emedim-chatbot.YOUR-SUBDOMAIN.workers.dev';

// Le temps de finir de fabriquer l'assistant : on affiche juste la bulle, la fenêtre ne s'ouvre pas.
const CHAT_ENABLED = false;

const t = locale === 'en'
  ? {
      bubbleLabel: 'Ask a question',
      title: 'Astronomy assistant',
      subtitle: 'Ask about our telescopes or astronomy',
      placeholder: 'Type your question…',
      send: 'Send',
      greeting: "Hi! I can answer your questions about astronomy and our products (Lumi, Picco, Smallest…). What would you like to know?",
      error: 'Sorry, the assistant is temporarily unavailable.',
    }
  : {
      bubbleLabel: 'Poser une question',
      title: 'Assistant astronomie',
      subtitle: 'Questions sur nos télescopes ou l\'astronomie',
      placeholder: 'Écris ta question…',
      send: 'Envoyer',
      greeting: "Salut ! Je peux répondre à tes questions sur l'astronomie et nos produits (Lumi, Picco, Smallest…). Qu'est-ce qui t'intéresse ?",
      error: "Désolé, l'assistant est momentanément indisponible.",
    };
---

<div class="chatbot-root" data-api-url={CHAT_API_URL} data-locale={locale}>
  <button class="chatbot-bubble" type="button" aria-label={t.bubbleLabel} aria-expanded="false">
    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" class="icon-chat">
      <path d="M12 3C7.03 3 3 6.58 3 11c0 2.39 1.19 4.53 3.08 5.99-.1.98-.5 2.2-1.38 3.51-.12.18-.02.42.19.45 1.86.27 3.5-.34 4.72-1.02.75.18 1.55.27 2.39.27 4.97 0 9-3.58 9-8s-4.03-8-9-8Z" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round" />
    </svg>
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" class="icon-close">
      <path d="M6 6l12 12M18 6L6 18" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
    </svg>
    <span class="chatbot-badge" aria-hidden="true"></span>
  </button>

  <div class="chatbot-panel" hidden>
    <div class="chatbot-header">
      <div>
        <p class="chatbot-title">{t.title}</p>
        <p class="chatbot-subtitle">{t.subtitle}</p>
      </div>
    </div>
    <div class="chatbot-messages" role="log" aria-live="polite">
      <div class="chatbot-message assistant">{t.greeting}</div>
    </div>
    <form class="chatbot-form">
      <input
        type="text"
        class="chatbot-input"
        placeholder={t.placeholder}
        maxlength="500"
        autocomplete="off"
      />
      <button type="submit" class="chatbot-send">{t.send}</button>
    </form>
  </div>
</div>

<script define:vars={{ errorMessage: t.error, enabled: CHAT_ENABLED }}>
  class ChatBotWidget {
    constructor(root, errorMessage, enabled) {
      this.root = root;
      this.errorMessage = errorMessage;
      this.enabled = enabled;
      this.apiUrl = root.dataset.apiUrl;
      this.bubble = root.querySelector('.chatbot-bubble');
      this.badge = root.querySelector('.chatbot-badge');
      this.panel = root.querySelector('.chatbot-panel');
      this.messagesEl = root.querySelector('.chatbot-messages');
      this.form = root.querySelector('.chatbot-form');
      this.input = root.querySelector('.chatbot-input');
      this.history = [];
      this.isOpen = false;
      this.isSending = false;

      if (!this.enabled) {
        this.badge.hidden = true;
      } else if (localStorage.getItem('chatbot-seen') === '1') {
        this.badge.hidden = true;
      }

      this.bubble.addEventListener('click', () => this.toggle());
      this.form.addEventListener('submit', (e) => this.handleSubmit(e));
    }

    toggle() {
      if (!this.enabled) return;
      this.isOpen = !this.isOpen;
      this.panel.hidden = !this.isOpen;
      this.bubble.setAttribute('aria-expanded', String(this.isOpen));
      this.root.classList.toggle('is-open', this.isOpen);
      if (this.isOpen) {
        this.input.focus();
        this.badge.hidden = true;
        localStorage.setItem('chatbot-seen', '1');
      }
    }

    addMessage(role, content) {
      const el = document.createElement('div');
      el.className = `chatbot-message ${role}`;
      el.textContent = content;
      this.messagesEl.appendChild(el);
      this.messagesEl.scrollTop = this.messagesEl.scrollHeight;
      return el;
    }

    async handleSubmit(e) {
      e.preventDefault();
      const message = this.input.value.trim();
      if (!message || this.isSending) return;

      this.input.value = '';
      this.addMessage('user', message);
      const typingEl = this.addMessage('assistant typing', '…');
      this.isSending = true;

      try {
        const res = await fetch(this.apiUrl, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ message, history: this.history }),
        });
        const data = await res.json();
        typingEl.remove();

        if (!res.ok) {
          this.addMessage('assistant error', data.error || 'Erreur');
        } else {
          this.addMessage('assistant', data.reply);
          this.history.push({ role: 'user', content: message });
          this.history.push({ role: 'assistant', content: data.reply });
        }
      } catch {
        typingEl.remove();
        this.addMessage('assistant error', this.errorMessage);
      } finally {
        this.isSending = false;
      }
    }
  }

  document.querySelectorAll('.chatbot-root').forEach((root) => new ChatBotWidget(root, errorMessage, enabled));
</script>

<style>
  .chatbot-root {
    position: fixed;
    right: 1.25rem;
    bottom: 1.25rem;
    z-index: 100;
  }

  .chatbot-bubble {
    position: relative;
    width: 3.5rem;
    height: 3.5rem;
    border-radius: 50%;
    border: none;
    background: var(--accent-regular);
    color: var(--gray-999);
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.25);
    transition: transform 0.2s ease;
  }

  .chatbot-bubble:hover {
    transform: scale(1.06);
  }

  .chatbot-badge {
    position: absolute;
    top: -0.15rem;
    right: -0.15rem;
    width: 0.85rem;
    height: 0.85rem;
    border-radius: 50%;
    background: #ff4d4f;
    border: 2px solid var(--gray-999);
    animation: chatbot-pulse 2s ease-in-out infinite;
  }

  .chatbot-badge[hidden] {
    display: none;
  }

  @keyframes chatbot-pulse {
    0%, 100% {
      transform: scale(1);
      opacity: 1;
    }
    50% {
      transform: scale(1.2);
      opacity: 0.7;
    }
  }

  .icon-close {
    display: none;
  }

  .chatbot-root.is-open .icon-chat {
    display: none;
  }

  .chatbot-root.is-open .icon-close {
    display: block;
  }

  .chatbot-panel[hidden] {
    display: none;
  }

  .chatbot-panel {
    position: absolute;
    right: 0;
    bottom: 4.25rem;
    width: min(22rem, calc(100vw - 2.5rem));
    height: min(30rem, calc(100vh - 8rem));
    background: var(--gray-999);
    border-radius: 1rem;
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.3);
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }

  .chatbot-header {
    padding: 1rem 1.25rem;
    background: var(--accent-regular);
    color: var(--gray-999);
  }

  .chatbot-title {
    margin: 0;
    font-size: var(--text-base);
    font-weight: 600;
  }

  .chatbot-subtitle {
    margin: 0.15rem 0 0;
    font-size: var(--text-sm);
    opacity: 0.85;
  }

  .chatbot-messages {
    flex: 1;
    overflow-y: auto;
    padding: 1rem;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .chatbot-message {
    padding: 0.6rem 0.85rem;
    border-radius: 0.75rem;
    font-size: var(--text-sm);
    line-height: 1.4;
    max-width: 85%;
    white-space: pre-wrap;
  }

  .chatbot-message.assistant {
    background: var(--gray-900);
    color: var(--gray-50);
    align-self: flex-start;
  }

  .chatbot-message.user {
    background: var(--accent-regular);
    color: var(--gray-999);
    align-self: flex-end;
  }

  .chatbot-message.error {
    background: #fde2e2;
    color: #8a1f1f;
  }

  .chatbot-message.typing {
    opacity: 0.6;
  }

  .chatbot-form {
    display: flex;
    gap: 0.5rem;
    padding: 0.75rem;
    border-top: 1px solid var(--gray-800);
  }

  .chatbot-input {
    flex: 1;
    border: 1px solid var(--gray-800);
    border-radius: 0.5rem;
    padding: 0.5rem 0.75rem;
    font-size: var(--text-sm);
    background: var(--gray-999);
    color: var(--gray-50);
  }

  .chatbot-send {
    border: none;
    background: var(--accent-regular);
    color: var(--gray-999);
    border-radius: 0.5rem;
    padding: 0.5rem 1rem;
    font-size: var(--text-sm);
    cursor: pointer;
  }

  @media (max-width: 480px) {
    .chatbot-root {
      right: 0.75rem;
      bottom: 0.75rem;
    }
  }
</style>
