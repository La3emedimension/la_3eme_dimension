---
import { getCollection } from 'astro:content';
import { getAlternatePath, type Locale } from '../i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const currentPath = Astro.url.pathname;
const alternatePath = getAlternatePath(currentPath, locale);
const targetLocale: Locale = locale === 'fr' ? 'en' : 'fr';

// Verify the counterpart page actually exists before linking to it —
// naive locale-prefix swapping produces 404s for asymmetric content
// (draft-only-in-one-locale products, mismatched blog slugs, fr-only static pages).
const routePath = alternatePath.replace(/^\/en\/?/, '').replace(/^\/|\/$/g, '');
const segments = routePath.split('/').filter(Boolean);

let alternateExists = false;

if (segments[0] === 'product' && segments[1]) {
  const products = await getCollection('products');
  alternateExists = products.some(p => p.id.replace(/\.json$/, '') === `${targetLocale}/${segments[1]}` && !p.data.draft);
} else if (segments[0] === 'blog' && segments[1]) {
  const blogEntries = await getCollection('blog');
  const slug = decodeURIComponent(segments[1]);
  alternateExists = blogEntries.some(e => e.id.replace(/\.md$/, '') === `${targetLocale}/${slug}`);
} else {
  const pageModules = import.meta.glob('/src/pages/**/*.astro');
  const routeSlug = routePath === '' ? 'index' : routePath;
  const filePath = `/src/pages/${targetLocale === 'en' ? 'en/' : ''}${routeSlug}.astro`;
  alternateExists = filePath in pageModules;
}

const href = alternateExists ? alternatePath : (targetLocale === 'en' ? '/en/' : '/');
---

<a href={href} class={`lang-toggle ${locale === 'en' ? 'lang-en' : 'lang-fr'}`} aria-label={locale === 'fr' ? 'Switch to English' : 'Passer en français'}>
  <span class="lang-icon lang-fr">FR</span>
  <span class="lang-icon lang-en">EN</span>
</a>

<style>
  .lang-toggle {
    display: flex;
    position: relative;
    border: 0;
    border-radius: 999rem;
    padding: 0;
    background-color: var(--gray-999);
    box-shadow: inset 0 0 0 1px var(--accent-overlay);
    cursor: pointer;
    text-decoration: none;
    overflow: hidden;
  }

  .lang-icon {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0.5rem;
    width: 2rem;
    height: 2rem;
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--accent-overlay);
    z-index: 2;
  }

  /* Background slider on the first icon (FR) */
  .lang-toggle .lang-icon.lang-fr::before {
    content: '';
    position: absolute;
    inset: 0;
    background-color: var(--accent-regular);
    border-radius: 999rem;
    z-index: -1;
  }

  /* Move background when English is active */
  .lang-toggle.lang-en .lang-icon.lang-fr::before {
    transform: translateX(100%);
  }

  /* Highlight active language */
  .lang-toggle.lang-en .lang-icon.lang-en,
  .lang-toggle.lang-fr .lang-icon.lang-fr {
    color: var(--accent-text-over);
  }

  @media (prefers-reduced-motion: no-preference) {
    .lang-icon,
    .lang-icon.lang-fr::before {
      transition:
        transform var(--theme-transition),
        color var(--theme-transition);
    }
  }

  @media (forced-colors: active) {
    .lang-icon.lang-fr::before {
      background-color: SelectedItem;
    }
  }
</style>
