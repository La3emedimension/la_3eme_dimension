---
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactCTA from '../components/ContactCTA.astro';
import Hero from '../components/Hero.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { useTranslations, localePath, type Locale } from '../i18n';
import { getLocalizedDataCollection, getSlugWithoutLocale } from '../lib/collections';

const locale: Locale = 'fr';
const t = useTranslations(locale);

const products = await getLocalizedDataCollection('products', locale);
const filteredProducts = products.filter(({ data }) => {
	return import.meta.env.DEV || !data.draft;
});

const categories = [
	{ id: 'all', name: t.shop.allProducts },
	{ id: 'services', name: t.shop.services },
	{ id: 'astronomie', name: t.shop.astronomy },
	{ id: 'accessoire', name: t.shop.accessories }
];

const allProducts = filteredProducts.sort((a, b) => {
	const aSlug = getSlugWithoutLocale(a.id, locale);
	const bSlug = getSlugWithoutLocale(b.id, locale);
	const order = ['smallest', 'lumi', 'lumi-customizable', 'picco', 'sur-mesure'];
	const aIdx = order.indexOf(aSlug);
	const bIdx = order.indexOf(bSlug);
	if (aIdx !== -1 && bIdx !== -1) return aIdx - bIdx;
	if (aIdx !== -1) return -1;
	if (bIdx !== -1) return 1;
	return 0;
});

// Business structured data for shop page
const shopStructuredData = {
	"@context": "https://schema.org",
	"@type": "CollectionPage",
	"name": "Boutique Astronomie Débutants - Télescopes et Accessoires | La 3ème dimension",
	"description": "Télescopes compacts pour débuter l'astronomie, accessoires essentiels et miroirs de qualité. Parfait pour observer la Lune, les planètes. Simple d'utilisation, fabrication française. Idéal débutants et amateurs.",
	"url": "https://la3emedim.fr/shop/",
	"mainEntity": {
		"@type": "ItemList",
		"numberOfItems": allProducts.length,
		"itemListElement": allProducts.map((product, index) => ({
			"@type": "ListItem",
			"position": index + 1,
			"item": {
				"@type": "Product",
				"name": product.data.structuredData?.name || product.id,
				"description": product.data.seoDescription,
				"url": `https://la3emedim.fr/product/${getSlugWithoutLocale(product.id, locale)}/`,
				"image": product.data.ogImage
			}
		}))
	}
};
---

<BaseLayout
	locale={locale}
	title="Boutique Astronomie Débutants - Télescopes Compacts et Accessoires | La 3ème dimension"
	description="Boutique astronomie pour débuter : télescopes compacts simples d'utilisation, accessoires essentiels (masques Bahtinov, vis collimation), miroirs de qualité. Parfait pour observer Lune et planètes. Fabrication française 3D. Livraison France."
	keywords="boutique astronomie débutant, télescope premier achat, accessoire télescope débutant, télescope facile utiliser, observer lune planètes, télescope compact portable, matériel astronomie débutant, masque bahtinov, vis collimation, télescope français, toulouse"
	structuredData={shopStructuredData}
>
	<div id="shipping-delay-notice" class="shipping-notice-overlay" hidden>
		<div class="shipping-notice-card" role="dialog" aria-modal="true" aria-labelledby="shipping-notice-title">
			<button type="button" class="shipping-notice-close" aria-label="Fermer">&times;</button>
			<p id="shipping-notice-title" class="shipping-notice-text">
				⚠️ Compte tenu de la forte demande et de notre participation au Salon du Made in France, les délais de livraison peuvent être plus longs que prévu. Merci de votre compréhension !
			</p>
			<p class="shipping-notice-text">Vous voulez venir au Salon du MIF ?</p>
			<a href="https://www.mifexpo.fr/espace-invitations/la-3eme-dimension-997256" target="_blank" rel="noopener noreferrer" class="shipping-notice-cta">Prenez votre invitation</a>
		</div>
	</div>

	<div class="stack gap-4 lg:gap-6">
		<div class="wrapper stack gap-2 lg:gap-4">
			<Breadcrumbs
				items={[
					{ label: 'Accueil', href: localePath('/', locale) },
					{ label: 'Boutique' }
				]}
				locale={locale}
			/>
			<header class="hero">
				<Hero
					title={t.shop.title}
					tagline={t.shop.tagline}
					align="start"
				/>
			</header>
			
			<!-- Category Filter -->
			<div class="category-filter">
				{categories.map((category) => (
					<button
						class={`category-btn ${category.id === 'all' ? 'active' : ''}`}
						data-category={category.id}
					>
						{category.name}
					</button>
				))}
			</div>
		</div>

		<main class="wrapper">
			<div class="product-grid">
				{allProducts.map((product) => {
					const heroSection = product.data.sections.find(s => s.type === 'hero');
					const heroData = heroSection?.data;
					const productSlug = getSlugWithoutLocale(product.id, locale);

					return (
						<article class="product-card" data-category={product.data.category || 'all'}>
							<a href={localePath(`/product/${productSlug}/`, locale)} class="card-link">
								<div class="card-image">
									<img
										src={product.data.shopImage?.src || heroData?.heroImage?.src || '/assets/placeholder.jpg'}
										alt={product.data.shopImage?.alt || heroData?.heroImage?.alt || product.id}
										style={product.data.shopImage?.objectPosition ? `object-position: ${product.data.shopImage.objectPosition}` : undefined}
										loading="lazy"
										decoding="async"
									/>
									{heroData?.imageOverlayText && (
										<div class="dev-badge">{heroData.imageOverlayText}</div>
									)}
									<div class="card-overlay">
										<span class="view-product">Voir le produit</span>
									</div>
								</div>
								<div class="card-content">
									<h3 class="product-title">
										{heroData?.title === 'Lumi'
											? <>L<span style="color:#5BC8F5">u</span><span style="color:#FFD93D">m</span><span style="color:#FF6FB7">i</span></>
											: (heroData?.title || product.id)
										}
										{import.meta.env.DEV && product.data.draft && (
											<span class="draft-badge">DRAFT</span>
										)}
									</h3>
									<p class="product-tagline">{heroData?.tagline}</p>

									{heroData?.features && (
										<ul class="product-features">
											{heroData.features.slice(0, 2).map((feature) => (
												<li class="feature-item">
													<span class="feature-text">{feature.text}</span>
												</li>
											))}
										</ul>
									)}

									<div class="card-footer">
										{product.data.price ? (
											<>
												<div class="price-section">
													<span class="price">{product.data.price}</span>
													{product.data.priceNote && (
														<span class="price-note">{product.data.priceNote}</span>
													)}
												</div>
												<div class="commander-btn">
													Commander ({product.data.price})
												</div>
											</>
										) : (
											<div class="commander-btn">
												Plus d'information
											</div>
										)}
									</div>
								</div>
							</a>
						</article>
					);
				})}
			</div>
		</main>

		<!-- Avis client Lumi -->
		<div class="wrapper">
			<section class="testimonial-section">
				<h2 class="testimonial-title">Avis clients</h2>
				<blockquote class="testimonial-card">
					<div class="testimonial-stars">★★★★★</div>
					<p class="testimonial-text">« Télescope coloré et robuste avec une vue parfaite de la Lune. Ma fille de 8 ans et demi est conquise. On a partagé en famille des moments d'étude et de beauté sous les étoiles. Le meilleur cadeau pour rêver ensemble. Qualité top ! »</p>
					<footer class="testimonial-author">
						<div class="testimonial-avatar">A</div>
						<div>
							<strong>Alessandra L.</strong>
							<span>— Lumi 🌙</span>
						</div>
					</footer>
				</blockquote>
			</section>
		</div>

		<!-- SEO Rich Content -->
		<div class="wrapper">
			<section class="seo-content">
				<h2>Instruments astronomiques et accessoires de précision</h2>
				<p>
					Découvrez notre sélection d'<strong>instruments astronomiques innovants</strong> et d'<strong>accessoires d'optique de précision</strong>.
					De la <strong>lunette astronomique éducative Lumi</strong> au <strong>miroir parabolique 150mm testé à l'interféromètre</strong>,
					chaque produit est conçu pour offrir des performances optimales aux astronomes amateurs et confirmés.
				</p>
				<div class="seo-highlights">
					<div class="highlight-item">
						<h3>Optiques de qualité professionnelle</h3>
						<p>Nos miroirs paraboliques sont testés à l'interféromètre pour garantir une qualité optique optimale. Idéal pour l'observation du ciel profond.</p>
					</div>
					<div class="highlight-item">
						<h3>Instruments éducatifs</h3>
						<p>La lunette Lumi permet de comprendre le fonctionnement d'un télescope tout en observant la Lune, les planètes et les nébuleuses brillantes.</p>
					</div>
					<div class="highlight-item">
						<h3>Accessoires de collimation</h3>
						<p>Vis moletées ergonomiques pour un réglage précis de votre télescope Newton sans outils. Compatible avec la plupart des instruments du marché.</p>
					</div>
				</div>
			</section>
		</div>

		<ContactCTA locale={locale} />
	</div>
</BaseLayout>

<style>
	.shipping-notice-overlay {
		position: fixed;
		inset: 0;
		z-index: 1000;
		display: flex;
		align-items: center;
		justify-content: center;
		padding: 1.5rem;
		background: rgba(0, 0, 0, 0.32);
		backdrop-filter: blur(18px) saturate(135%);
		-webkit-backdrop-filter: blur(18px) saturate(135%);
		opacity: 1;
		transition: opacity 0.25s ease;
	}

	.shipping-notice-overlay[hidden] {
		display: none;
	}

	.shipping-notice-overlay.is-closing {
		opacity: 0;
		pointer-events: none;
	}

	.shipping-notice-card {
		position: relative;
		max-width: 480px;
		width: 100%;
		background: var(--gray-900);
		background: linear-gradient(135deg, rgba(255, 255, 255, 0.14) 0%, rgba(255, 255, 255, 0.02) 45%, rgba(255, 255, 255, 0) 60%),
			color-mix(in srgb, var(--gray-900) 55%, transparent);
		backdrop-filter: blur(20px) saturate(160%);
		-webkit-backdrop-filter: blur(20px) saturate(160%);
		border: 1px solid rgba(255, 255, 255, 0.2);
		border-radius: 1.25rem;
		padding: 2rem 1.75rem;
		box-shadow:
			0 8px 32px rgba(0, 0, 0, 0.3),
			inset 0 1px 0 rgba(255, 255, 255, 0.2);
	}

	.shipping-notice-close {
		position: absolute;
		top: 0.6rem;
		right: 0.6rem;
		width: 2rem;
		height: 2rem;
		display: flex;
		align-items: center;
		justify-content: center;
		background: rgba(255, 255, 255, 0.12);
		backdrop-filter: blur(6px);
		-webkit-backdrop-filter: blur(6px);
		border: 1px solid rgba(255, 255, 255, 0.2);
		border-radius: 50%;
		color: var(--gray-100);
		font-size: 1.4rem;
		line-height: 1;
		cursor: pointer;
		padding: 0;
	}

	.shipping-notice-close:hover {
		background: rgba(255, 255, 255, 0.22);
	}

	.shipping-notice-text {
		margin: 0;
		font-size: var(--text-base);
		line-height: 1.6;
		color: var(--gray-100);
		text-align: center;
	}

	.shipping-notice-text + .shipping-notice-text {
		margin-top: 1rem;
	}

	.shipping-notice-cta {
		display: block;
		text-align: center;
		margin-top: 1rem;
		padding: 0.75rem 1.5rem;
		font-size: var(--text-base);
		font-weight: 600;
		background: var(--accent-regular);
		color: var(--accent-text-over);
		border-radius: 0.5rem;
		text-decoration: none;
	}

	.shipping-notice-cta:hover {
		background: var(--accent-dark);
	}

	.hero {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 2rem;
	}

	.roles {
		display: flex;
		gap: 0.5rem;
		flex-wrap: wrap;
		justify-content: center;
	}

	.pill {
		display: flex;
		padding: 0.5rem 1rem;
		gap: 0.5rem;
		color: var(--accent-text-over);
		border: 1px solid var(--accent-regular);
		background-color: var(--accent-regular);
		border-radius: 999rem;
		font-size: var(--text-sm);
		line-height: 1.35;
		white-space: nowrap;
	}

	/* Section Styles */
	.section {
		display: grid;
		gap: 2rem;
	}

	.with-background {
		position: relative;
	}

	.with-background::before {
		--hero-bg: var(--bg-image-subtle-2);
		content: '';
		position: absolute;
		pointer-events: none;
		left: 50%;
		width: 100vw;
		aspect-ratio: calc(2.25 / var(--bg-scale));
		top: 0;
		transform: translateY(-75%) translateX(-50%);
		background:
			url('/assets/backgrounds/noise.png') top center/220px repeat,
			var(--hero-bg) center center / var(--bg-gradient-size) no-repeat,
			var(--gray-999);
		background-blend-mode: overlay, normal, normal, normal;
		mix-blend-mode: var(--bg-blend-mode);
		z-index: -1;
	}

	.with-background.bg-variant::before {
		--hero-bg: var(--bg-image-subtle-1);
	}

	.section-header {
		justify-self: center;
		text-align: center;
		max-width: 50ch;
		font-size: var(--text-md);
		color: var(--gray-300);
	}

	.section-header h2 {
		font-size: var(--text-2xl);
		color: var(--gray-100);
	}

	/* Category Filter */
	/* SEO Content */
	.seo-content {
		max-width: 900px;
		margin: 2rem auto;
		padding: 2rem;
		background: var(--gradient-subtle);
		border-radius: 1rem;
		border: 1px solid var(--gray-800);
	}

	.seo-content h2 {
		font-size: var(--text-2xl);
		color: var(--gray-100);
		margin-bottom: 1rem;
		text-align: center;
	}

	.seo-content > p {
		font-size: var(--text-base);
		color: var(--gray-300);
		line-height: 1.7;
		margin-bottom: 2rem;
		text-align: center;
	}

	.seo-highlights {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
		gap: 1.5rem;
		margin-top: 2rem;
	}

	.highlight-item {
		padding: 1.5rem;
		background: var(--gray-900);
		border-radius: 0.75rem;
		border: 1px solid var(--gray-800);
	}

	.highlight-item h3 {
		font-size: var(--text-lg);
		color: var(--accent-regular);
		margin-bottom: 0.75rem;
	}

	.highlight-item p {
		font-size: var(--text-sm);
		color: var(--gray-400);
		line-height: 1.6;
		margin: 0;
	}

	@media (max-width: 50em) {
		.seo-content {
			padding: 1.5rem;
			margin: 1.5rem 1rem;
		}

		.seo-content h2 {
			font-size: var(--text-xl);
		}

		.seo-highlights {
			grid-template-columns: 1fr;
			gap: 1rem;
		}
	}

	.category-filter {
		display: flex;
		justify-content: center;
		flex-wrap: wrap;
		gap: 1rem;
		margin-bottom: 1rem;
		padding: 0 1rem;
	}

	.category-btn {
		padding: 0.75rem 1.5rem;
		border: 1px solid rgba(255, 255, 255, 0.18);
		background: var(--gray-900);
		background: linear-gradient(135deg, rgba(255, 255, 255, 0.14) 0%, rgba(255, 255, 255, 0.02) 50%, rgba(255, 255, 255, 0) 70%),
			color-mix(in srgb, var(--gray-900) 55%, transparent);
		backdrop-filter: blur(16px) saturate(160%);
		-webkit-backdrop-filter: blur(16px) saturate(160%);
		color: var(--gray-300);
		border-radius: 2rem;
		font-weight: 500;
		cursor: pointer;
		transition: all var(--theme-transition);
		font-size: var(--text-sm);
		white-space: nowrap;
		transform: translateY(0);
		box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.15);
	}

	.category-btn:hover {
		border-color: rgba(255, 255, 255, 0.3);
		color: var(--gray-100);
		background: var(--gray-800);
		background: linear-gradient(135deg, rgba(255, 255, 255, 0.2) 0%, rgba(255, 255, 255, 0.04) 50%, rgba(255, 255, 255, 0) 70%),
			color-mix(in srgb, var(--gray-800) 55%, transparent);
		transform: translateY(-2px);
		box-shadow: var(--shadow-sm), inset 0 1px 0 rgba(255, 255, 255, 0.2);
	}

	.category-btn.active {
		border-color: rgba(255, 255, 255, 0.35);
		background: var(--accent-regular);
		background: linear-gradient(135deg, rgba(255, 255, 255, 0.3) 0%, rgba(255, 255, 255, 0.05) 50%, rgba(255, 255, 255, 0) 70%),
			color-mix(in srgb, var(--accent-regular) 75%, transparent);
		backdrop-filter: blur(16px) saturate(180%);
		-webkit-backdrop-filter: blur(16px) saturate(180%);
		color: var(--accent-text-over);
		transform: translateY(-3px);
		box-shadow: var(--shadow-md), inset 0 1px 0 rgba(255, 255, 255, 0.3);
	}

	/* Product Grid */
	.product-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
		gap: 2rem;
		width: 100%;
		transition: all 0.3s ease;
	}

	.product-card {
		transition: all 0.3s ease;
	}

	.product-card.hidden {
		opacity: 0;
		transform: scale(0.9);
		pointer-events: none;
	}

	.product-card:not(.hidden) {
		background: var(--gradient-subtle);
		border: 1px solid var(--gray-800);
		border-radius: 1rem;
		overflow: hidden;
		transition: all var(--theme-transition);
		filter: grayscale(20%);
		height: 100%;
		display: flex;
		flex-direction: column;
	}

	.product-card:hover {
		transform: translateY(-0.25rem);
		box-shadow: var(--shadow-lg);
		filter: grayscale(0%);
	}

	.card-link {
		display: flex;
		flex-direction: column;
		text-decoration: none;
		color: inherit;
		height: 100%;
	}

	.card-image {
		position: relative;
		aspect-ratio: 4 / 3;
		overflow: hidden;
		flex-shrink: 0;
	}

	.card-image img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		transition: transform var(--theme-transition);
	}

	.product-card:hover .card-image img {
		transform: scale(1.05);
	}

	.dev-badge {
		position: absolute;
		top: 50%;
		left: 50%;
		transform: translate(-50%, -50%);
		background: rgba(0, 0, 0, 0.72);
		color: #fff;
		font-weight: 700;
		font-size: 0.8rem;
		padding: 0.5rem 1rem;
		border-radius: 0.4rem;
		text-align: center;
		border: 2px solid rgba(255, 255, 255, 0.25);
		backdrop-filter: blur(4px);
		pointer-events: none;
		white-space: nowrap;
		z-index: 1;
	}

	.card-overlay {
		position: absolute;
		inset: 0;
		background: linear-gradient(to bottom, transparent 0%, rgba(0,0,0,0.8) 100%);
		display: flex;
		align-items: flex-end;
		justify-content: center;
		padding: 1rem;
		opacity: 0;
		transition: opacity var(--theme-transition);
	}

	.product-card:hover .card-overlay {
		opacity: 1;
	}

	.view-product {
		color: white;
		font-weight: 600;
		background: var(--accent-regular);
		padding: 0.5rem 1rem;
		border-radius: 0.5rem;
		font-size: var(--text-sm);
	}

	.card-content {
		padding: 1rem;
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
		flex-grow: 1;
	}

	.product-title {
		font-size: var(--text-lg);
		font-weight: 600;
		color: var(--gray-100);
		margin: 0;
	}

	.product-tagline {
		font-size: var(--text-sm);
		color: var(--accent-regular);
		font-weight: 500;
		margin: 0;
	}

	.product-features {
		list-style: none;
		padding: 0;
		margin: 0.5rem 0 0 0;
		display: flex;
		flex-direction: column;
		gap: 0.25rem;
	}

	.feature-item {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		font-size: var(--text-xs);
		color: var(--gray-400);
	}

	.feature-item::before {
		content: '•';
		color: var(--accent-regular);
		font-weight: 600;
	}

	.feature-text {
		line-height: 1.2;
	}

	.card-footer {
		margin-top: auto;
		padding-top: 0.5rem;
		border-top: 1px solid var(--gray-800);
		display: flex;
		flex-direction: column;
		gap: 0.6rem;
	}

	.price-section {
		display: flex;
		align-items: baseline;
		gap: 0.5rem;
		justify-content: center;
	}

	.commander-btn {
		display: block;
		text-align: center;
		background: var(--accent-regular);
		color: var(--accent-text-over);
		padding: 0.6rem 1rem;
		border-radius: 0.5rem;
		font-size: var(--text-sm);
		font-weight: 600;
		transition: opacity var(--theme-transition);
	}

	.product-card:hover .commander-btn {
		opacity: 0.9;
	}

	.price {
		font-size: var(--text-lg);
		font-weight: 600;
		color: var(--accent-regular);
	}

	.price-note {
