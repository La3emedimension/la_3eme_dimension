---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Icon from "../../components/Icon.astro";
import { useTranslations, localePath, type Locale } from '../../i18n';
import { getLocalizedCollection, getSlugWithoutLocale } from '../../lib/collections';

const locale: Locale = 'en';
const t = useTranslations(locale);

const CATEGORY_LABELS: Record<string, string> = {
  pedagogie: 'Learning',
  evenements: 'Events',
  actualites: 'News & Press',
  coulisses: 'Behind the Scenes',
  portraits: 'Portraits',
  astronomie: 'Astronomy',
};
const CATEGORY_ORDER = ['pedagogie', 'evenements', 'actualites', 'coulisses', 'portraits', 'astronomie'];

const blogPosts = await getLocalizedCollection('blog', locale);
const filteredPosts = blogPosts.filter(({ data }) => data.draft !== true);
const sortedPosts = filteredPosts.sort((a, b) =>
  b.data.publishDate.valueOf() - a.data.publishDate.valueOf()
);

const presentCategories = CATEGORY_ORDER.filter((cat) =>
  sortedPosts.some((post) => post.data.category === cat)
);

const formatDate = (date: Date) => {
  return date.toLocaleDateString("en-GB", {
    year: "numeric",
    month: "long",
    day: "numeric"
  });
};
---

<BaseLayout
  locale={locale}
  title="Blog - La 3ème dimension"
  description="Articles and news from La 3ème dimension"
  keywords="3d printing blog, telescope news, 3d innovations"
>
  <div class="stack gap-20 lg:gap-48">
    <div class="wrapper stack gap-8 lg:gap-20">
      <header class="hero">
        <h1>{t.blog.title}</h1>
        <p>{t.blog.tagline}</p>
      </header>

      {presentCategories.length > 0 && (
        <div class="category-filters" role="tablist" aria-label="Filter articles by category">
          <button type="button" class="filter-tab is-active" data-filter="all">All</button>
          {presentCategories.map((cat) => (
            <button type="button" class="filter-tab" data-filter={cat}>{CATEGORY_LABELS[cat]}</button>
          ))}
        </div>
      )}

      <main class="blog-grid">
        {sortedPosts.length === 0 ? (
          <p class="no-posts">No articles yet. Check back soon!</p>
        ) : (
          sortedPosts.map((post) => {
            const postSlug = getSlugWithoutLocale(post.id, locale);
            return (
            <article class="blog-card" data-category={post.data.category ?? 'other'}>
              <a href={localePath(`/blog/${postSlug}/`, locale)}>
                {post.data.img && (
                  <div class="image-container">
                    {post.data.category && (
                      <span class="category-badge">{CATEGORY_LABELS[post.data.category]}</span>
                    )}
                    <img src={post.data.img} alt={post.data.img_alt || post.data.title} loading="lazy" decoding="async" />
                    <div class="image-overlay">
                      <h2 class="overlay-title">{post.data.title}</h2>
                    </div>
                  </div>
                )}
                <div class="content">
                  <div class="content-row">
                    <time datetime={post.data.publishDate.toISOString()}>
                      {formatDate(post.data.publishDate)}
                    </time>
                    <span class="read-more">
                      Read article <Icon icon="arrow-right" size="1em" />
                    </span>
                  </div>
                </div>
              </a>
            </article>
          );})
        )}
      </main>
    </div>
  </div>
</BaseLayout>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const tabs = document.querySelectorAll<HTMLButtonElement>('.filter-tab');
    const cards = document.querySelectorAll<HTMLElement>('.blog-card');
    if (!tabs.length) return;

    tabs.forEach((tab) => {
      tab.addEventListener('click', () => {
        tabs.forEach((t) => t.classList.remove('is-active'));
        tab.classList.add('is-active');
        const filter = tab.dataset.filter;
        cards.forEach((card) => {
          const match = filter === 'all' || card.dataset.category === filter;
          card.hidden = !match;
        });
      });
    });
  });
</script>

<style>
  .hero { text-align: center; padding: 2rem 0; }
  .hero h1 { font-size: var(--text-4xl); font-weight: 700; margin-bottom: 0.5rem; background: var(--gradient-accent); background-clip: text; -webkit-background-clip: text; -webkit-text-fill-color: transparent; }
  .hero p { font-size: var(--text-lg); color: var(--gray-400); }
  .category-filters { display: flex; flex-wrap: wrap; justify-content: center; gap: 0.6rem; margin: 0 0 0.5rem; }
  .filter-tab { appearance: none; -webkit-appearance: none; border: 1px solid var(--gray-800) !important; background-color: var(--gray-900) !important; color: var(--gray-300) !important; padding: 0.45rem 1rem; border-radius: 2rem; font-size: var(--text-sm); font-weight: 500; cursor: pointer; transition: all var(--theme-transition); }
  .filter-tab:hover { border-color: var(--accent-regular) !important; color: var(--gray-50) !important; }
  .filter-tab.is-active { background-color: var(--accent-regular) !important; border-color: var(--accent-regular) !important; color: var(--accent-text-over) !important; }
  .category-badge { position: absolute; top: 0.6rem; left: 0.6rem; z-index: 1; background: rgba(10, 10, 15, 0.75); color: var(--gray-50); font-size: 0.7rem; font-weight: 600; letter-spacing: 0.02em; padding: 0.25rem 0.6rem; border-radius: 1rem; backdrop-filter: blur(2px); }
  .blog-grid { display: grid; gap: 2rem; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); }
  .blog-card[hidden] { display: none; }
  .blog-card { border-radius: 1rem; overflow: hidden; background: var(--gradient-subtle); border: 1px solid var(--gray-800); transition: all var(--theme-transition); height: 140px; }
  .blog-card:hover { transform: translateY(-2px); box-shadow: var(--shadow-lg); border-color: var(--accent-regular); }
  .blog-card a { text-decoration: none; color: inherit; display: flex; flex-direction: column; height: 100%; }
  .image-container { position: relative; overflow: hidden; }
  .blog-card img { width: 100%; height: 90px; object-fit: cover; transition: transform var(--theme-transition); }
  .image-overlay { position: absolute; top: 0; left: 0; right: 0; bottom: 0; background: linear-gradient(135deg, rgba(142, 142, 147, 0.6) 0%, rgba(0, 0, 0, 0.8) 100%); display: flex; align-items: flex-end; padding: 1rem; }
  .overlay-title { color: white; font-size: var(--text-base); font-weight: 600; margin: 0; text-shadow: 2px 2px 4px rgba(0, 0, 0, 0.8); line-height: 1.3; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; text-overflow: ellipsis; max-height: 2.6em; }
  .content { padding: 0.75rem; flex: 1; display: flex; align-items: center; }
  .content-row { display: flex; justify-content: space-between; align-items: center; width: 100%; }
  .content time { font-size: var(--text-sm); color: var(--gray-400); text-transform: uppercase; font-weight: 500; }
  .read-more { display: inline-flex; align-items: center; gap: 0.5rem; font-size: var(--text-sm); color: var(--accent-regular); font-weight: 500; }
  .no-posts { text-align: center; padding: 4rem 2rem; font-size: var(--text-lg); color: var(--gray-400); grid-column: 1 / -1; }
</style>
