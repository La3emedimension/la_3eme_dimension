---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ContactCTA from '../../components/ContactCTA.astro';
import Hero from '../../components/Hero.astro';
import { useTranslations, localePath, type Locale } from '../../i18n';
import { getLocalizedDataCollection, getSlugWithoutLocale } from '../../lib/collections';

const locale: Locale = 'en';
const t = useTranslations(locale);

const products = await getLocalizedDataCollection('products', locale);
const filteredProducts = products.filter(({ data }) => {
	return import.meta.env.DEV || !data.draft;
});

const allProducts = filteredProducts.sort((a, b) => {
	const aSlug = getSlugWithoutLocale(a.id, locale);
	const bSlug = getSlugWithoutLocale(b.id, locale);
	const order = ['smallest', 'lumi', 'lumi-customizable', 'picco', 'sur-mesure'];
	const aIdx = order.indexOf(aSlug);
	const bIdx = order.indexOf(bSlug);
	if (aIdx !== -1 && bIdx !== -1) return aIdx - bIdx;
	if (aIdx !== -1) return -1;
	if (bIdx !== -1) return 1;
	return 0;
});

const shopStructuredData = {
	"@context": "https://schema.org",
	"@type": "CollectionPage",
	"name": "Shop La 3ème dimension",
	"description": "Discover our range of 3D printed products: portable telescopes, travel accessories and educational instruments.",
	"url": "https://la3emedim.fr/en/shop/",
	"mainEntity": {
		"@type": "ItemList",
		"numberOfItems": allProducts.length,
		"itemListElement": allProducts.map((product, index) => ({
			"@type": "ListItem",
			"position": index + 1,
			"item": {
				"@type": "Product",
				"name": product.data.structuredData?.name || product.id,
				"description": product.data.seoDescription,
				"url": `https://la3emedim.fr/en/product/${getSlugWithoutLocale(product.id, locale)}/`,
				"image": product.data.ogImage
			}
		}))
	}
};
---

<BaseLayout
	locale={locale}
	title="Shop - 3D Printed Products | La 3ème dimension"
	description="Discover our range of 3D printed products: portable Smallest telescopes, BHH travel accessories, Lumi educational instruments. French innovation and quality."
	keywords="3d printing shop, portable telescope, travel accessory, educational instrument, smallest telescope, backpack hook, astronomical eyepiece, toulouse"
	structuredData={shopStructuredData}
>
	<div id="shipping-delay-notice" class="shipping-notice-overlay" hidden>
		<div class="shipping-notice-card" role="dialog" aria-modal="true" aria-labelledby="shipping-notice-title">
			<button type="button" class="shipping-notice-close" aria-label="Close">&times;</button>
			<p id="shipping-notice-title" class="shipping-notice-text">
				⚠️ Due to high demand and our participation in the Made in France trade show, delivery times may be longer than expected. Thank you for your understanding!
			</p>
			<p class="shipping-notice-text">Want to come to the Salon du MIF?</p>
			<a href="https://www.mifexpo.fr/espace-invitations/la-3eme-dimension-997256" target="_blank" rel="noopener noreferrer" class="shipping-notice-cta">Get your invitation</a>
		</div>
	</div>

	<div class="stack gap-4 lg:gap-6">
		<div class="wrapper stack gap-2 lg:gap-4">
			<header class="hero">
				<Hero
					title={t.shop.title}
					tagline={t.shop.tagline}
					align="start"
				/>
			</header>
		</div>

		<main class="wrapper">
			<div class="product-grid">
				{allProducts.map((product) => {
					const heroSection = product.data.sections.find(s => s.type === 'hero');
					const heroData = heroSection?.data;
					const productSlug = getSlugWithoutLocale(product.id, locale);

					return (
						<article class="product-card" data-category={product.data.category || 'all'}>
							<a href={localePath(`/product/${productSlug}/`, locale)} class="card-link">
								<div class="card-image">
									<img
										src={product.data.shopImage?.src || heroData?.heroImage?.src || '/assets/placeholder.jpg'}
										alt={product.data.shopImage?.alt || heroData?.heroImage?.alt || product.id}
										style={product.data.shopImage?.objectPosition ? `object-position: ${product.data.shopImage.objectPosition}` : undefined}
										loading="lazy"
										decoding="async"
									/>
									<div class="card-overlay">
										<span class="view-product">View product</span>
									</div>
								</div>
								<div class="card-content">
									<h3 class="product-title">
										{heroData?.title || product.id}
										{import.meta.env.DEV && product.data.draft && (
											<span class="draft-badge">DRAFT</span>
										)}
									</h3>
									<p class="product-tagline">{heroData?.tagline}</p>

									{heroData?.features && (
										<ul class="product-features">
											{heroData.features.slice(0, 2).map((feature) => (
												<li class="feature-item">
													<span class="feature-text">{feature.text}</span>
												</li>
											))}
										</ul>
									)}

									{product.data.price && (
										<div class="card-footer">
											<div class="price-section">
												<span class="price">{product.data.price}</span>
												{product.data.priceNote && (
													<span class="price-note">{product.data.priceNote}</span>
												)}
											</div>
										</div>
									)}
								</div>
							</a>
						</article>
					);
				})}
			</div>
		</main>

		<ContactCTA locale={locale} />
	</div>
</BaseLayout>

<style>
	.shipping-notice-overlay {
		position: fixed;
		inset: 0;
		z-index: 1000;
		display: flex;
		align-items: center;
		justify-content: center;
		padding: 1.5rem;
		background: rgba(0, 0, 0, 0.32);
		backdrop-filter: blur(18px) saturate(135%);
		-webkit-backdrop-filter: blur(18px) saturate(135%);
		opacity: 1;
		transition: opacity 0.25s ease;
	}

	.shipping-notice-overlay[hidden] {
		display: none;
	}

	.shipping-notice-overlay.is-closing {
		opacity: 0;
		pointer-events: none;
	}

	.shipping-notice-card {
		position: relative;
		max-width: 480px;
		width: 100%;
		background: var(--gray-900);
		background: var(--glass-sheen), var(--glass-tint);
		backdrop-filter: blur(20px) saturate(160%);
		-webkit-backdrop-filter: blur(20px) saturate(160%);
		border: 1px solid rgba(255, 255, 255, 0.2);
		border-radius: 1.25rem;
		padding: 2rem 1.75rem;
		box-shadow:
			0 8px 32px rgba(0, 0, 0, 0.3),
			inset 0 1px 0 rgba(255, 255, 255, 0.2);
	}

	.shipping-notice-close {
		position: absolute;
		top: 0.6rem;
		right: 0.6rem;
		width: 2rem;
		height: 2rem;
		display: flex;
		align-items: center;
		justify-content: center;
		background: rgba(255, 255, 255, 0.12);
		backdrop-filter: blur(6px);
		-webkit-backdrop-filter: blur(6px);
		border: 1px solid rgba(255, 255, 255, 0.2);
		border-radius: 50%;
		color: var(--gray-100);
		font-size: 1.4rem;
		line-height: 1;
		cursor: pointer;
		padding: 0;
	}

	.shipping-notice-close:hover {
		background: rgba(255, 255, 255, 0.22);
	}

	.shipping-notice-text {
		margin: 0;
		font-size: var(--text-base);
		line-height: 1.6;
		color: var(--gray-100);
		text-align: center;
	}

	.shipping-notice-text + .shipping-notice-text {
		margin-top: 1rem;
	}

	.shipping-notice-cta {
		display: block;
		text-align: center;
		margin-top: 1rem;
		padding: 0.75rem 1.5rem;
		font-size: var(--text-base);
		font-weight: 600;
		background: var(--accent-regular);
		color: var(--accent-text-over);
		border-radius: 0.5rem;
		text-decoration: none;
	}

	.shipping-notice-cta:hover {
		background: var(--accent-dark);
	}

	.hero {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 2rem;
	}

	.roles {
		display: flex;
		gap: 0.5rem;
		flex-wrap: wrap;
		justify-content: center;
	}

	.pill {
		display: flex;
		padding: 0.5rem 1rem;
		gap: 0.5rem;
		color: var(--accent-text-over);
		border: 1px solid var(--accent-regular);
		background-color: var(--accent-regular);
		border-radius: 999rem;
		font-size: var(--text-sm);
		line-height: 1.35;
		white-space: nowrap;
	}

	.section {
		display: grid;
		gap: 2rem;
	}

	.with-background {
		position: relative;
	}

	.with-background::before {
		--hero-bg: var(--bg-image-subtle-2);
		content: '';
		position: absolute;
		pointer-events: none;
		left: 50%;
		width: 100vw;
		aspect-ratio: calc(2.25 / var(--bg-scale));
		top: 0;
		transform: translateY(-75%) translateX(-50%);
		background:
			url('/assets/backgrounds/noise.png') top center/220px repeat,
			var(--hero-bg) center center / var(--bg-gradient-size) no-repeat,
			var(--gray-999);
		background-blend-mode: overlay, normal, normal, normal;
		mix-blend-mode: var(--bg-blend-mode);
		z-index: -1;
	}

	.with-background.bg-variant::before {
		--hero-bg: var(--bg-image-subtle-1);
	}

	.section-header {
		justify-self: center;
		text-align: center;
		max-width: 50ch;
		font-size: var(--text-md);
		color: var(--gray-300);
	}

	.section-header h2 {
		font-size: var(--text-2xl);
		color: var(--gray-100);
	}


	.product-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
		gap: 2rem;
		width: 100%;
		transition: all 0.3s ease;
	}

	.product-card {
		transition: all 0.3s ease;
	}

	.product-card.hidden {
		opacity: 0;
		transform: scale(0.9);
		pointer-events: none;
	}

	.product-card:not(.hidden) {
		background: var(--gradient-subtle);
		background: var(--glass-sheen), var(--glass-tint);
		backdrop-filter: blur(20px) saturate(160%);
		-webkit-backdrop-filter: blur(20px) saturate(160%);
		border: 1px solid var(--glass-border-color);
		box-shadow: var(--glass-highlight);
		border-radius: 1rem;
		overflow: hidden;
		transition: all var(--theme-transition);
		filter: grayscale(20%);
		height: 100%;
		display: flex;
		flex-direction: column;
	}

	.product-card:hover {
		transform: translateY(-0.25rem);
		box-shadow: var(--shadow-lg);
		filter: grayscale(0%);
	}

	.card-link {
		display: flex;
		flex-direction: column;
		text-decoration: none;
		color: inherit;
		height: 100%;
	}

	.card-image {
		position: relative;
		aspect-ratio: 4 / 3;
		overflow: hidden;
		flex-shrink: 0;
	}

	.card-image img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		transition: transform var(--theme-transition);
	}

	.product-card:hover .card-image img {
		transform: scale(1.05);
	}

	.card-overlay {
		position: absolute;
		inset: 0;
		background: linear-gradient(to bottom, transparent 0%, rgba(0,0,0,0.8) 100%);
		display: flex;
		align-items: flex-end;
		justify-content: center;
		padding: 1rem;
		opacity: 0;
		transition: opacity var(--theme-transition);
	}

	.product-card:hover .card-overlay {
		opacity: 1;
	}

	.view-product {
		color: white;
		font-weight: 600;
		background: var(--accent-regular);
		padding: 0.5rem 1rem;
		border-radius: 0.5rem;
		font-size: var(--text-sm);
	}

	.card-content {
		padding: 1rem;
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
		flex-grow: 1;
	}

	.product-title {
		font-size: var(--text-lg);
		font-weight: 600;
		color: var(--gray-100);
		margin: 0;
	}

	.product-tagline {
		font-size: var(--text-sm);
		color: var(--accent-regular);
		font-weight: 500;
		margin: 0;
	}

	.product-features {
		list-style: none;
		padding: 0;
		margin: 0.5rem 0 0 0;
		display: flex;
		flex-direction: column;
		gap: 0.25rem;
	}

	.feature-item {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		font-size: var(--text-xs);
		color: var(--gray-400);
	}

	.feature-item::before {
		content: '•';
		color: var(--accent-regular);
		font-weight: 600;
	}

	.feature-text {
		line-height: 1.2;
	}

	.card-footer {
		margin-top: auto;
		padding-top: 0.5rem;
		border-top: 1px solid var(--gray-800);
	}

	.price-section {
		display: flex;
		align-items: baseline;
		gap: 0.5rem;
		justify-content: center;
	}

	.price {
		font-size: var(--text-lg);
		font-weight: 600;
		color: var(--accent-regular);
	}

	.price-note {
		font-size: var(--text-xs);
		color: var(--gray-400);
	}

	.draft-badge {
		display: inline-block;
		margin-left: 0.5rem;
		padding: 0.125rem 0.375rem;
		font-size: var(--text-xs);
		font-weight: 600;
		background: orange;
		color: white;
		border-radius: 0.25rem;
		text-transform: uppercase;
		letter-spacing: 0.025em;
	}

	@media (min-width: 50em) {
		.section {
			grid-template-columns: repeat(4, 1fr);
			grid-template-areas: 'header header header header' 'gallery gallery gallery gallery';
			gap: 5rem;
		}

		.section-header {
			grid-area: header;
			font-size: var(--text-lg);
		}

		.section-header h2 {
			font-size: var(--text-4xl);
		}

		.product-grid {
			grid-area: gallery;
			grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
			gap: 2.5rem;
		}

		.hero {
			display: grid;
			grid-template-columns: 6fr 4fr;
			padding-inline: 2.5rem;
			gap: 3.75rem;
		}

		.roles {
			margin-top: 0.5rem;
			justify-content: flex-start;
		}
	}

	@media (min-width: 80em) {
		.product-grid {
			grid-template-columns: repeat(3, 1fr);
		}
	}
</style>

<script>
document.addEventListener('DOMContentLoaded', function() {
	const notice = document.getElementById('shipping-delay-notice');
	const noticeStorageKey = 'shippingDelayNoticeDismissed';

	if (notice && !sessionStorage.getItem(noticeStorageKey)) {
		notice.hidden = false;

		const dismissNotice = () => {
			if (notice.hidden || notice.classList.contains('is-closing')) return;
			notice.classList.add('is-closing');
			window.setTimeout(() => {
				notice.hidden = true;
				notice.classList.remove('is-closing');
				sessionStorage.setItem(noticeStorageKey, '1');
			}, 250);
		};

		notice.querySelector('.shipping-notice-close')?.addEventListener('click', dismissNotice);
		notice.addEventListener('click', (e) => {
			if (e.target === notice) dismissNotice();
		});
		document.addEventListener('keydown', (e) => {
			if (e.key === 'Escape' && !notice.hidden) dismissNotice();
		});
	}

	const productCards = document.querySelectorAll('.product-card');
	const surMesureCard = document.querySelector('.product-card[data-category="services"]');

	const smallestCard = Array.from(productCards).find(card =>
		card.querySelector('a')?.href.includes('/smallest')
	);
	if (smallestCard) {
		smallestCard.style.order = '-5';
	}

	const ertCard = Array.from(productCards).find(card => {
		const href = card.querySelector('a')?.href ?? '';
		return href.includes('/lumi') && !href.includes('/lumi-customizable');
	});
	if (ertCard) {
		ertCard.style.order = '-4';
	}

	const lumiCustomCard = Array.from(productCards).find(card =>
		card.querySelector('a')?.href.includes('/lumi-customizable')
	);
	if (lumiCustomCard) {
		lumiCustomCard.style.order = '-3';
	}

	const piccoCard = Array.from(productCards).find(card =>
		card.querySelector('a')?.href.includes('/picco')
	);
	if (piccoCard) {
		piccoCard.style.order = '-2';
	}

	if (surMesureCard) {
		surMesureCard.style.order = '-1';
	}
});
</script>
